# Copy to .env for local overrides. Placeholders only — never commit real secrets.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DATABASE_PATH=./data/db.sqlite3
LOG_LEVEL=INFO
# Read by config.settings.prod only (true/false; anything else stops start-up):
# reuse the reverse proxy's X-Request-ID (default true; Nginx always sets it)
DJANGO_TRUST_INCOMING_REQUEST_ID=true
# HSTS includeSubDomains / preload: off until the production domain is final (default false)
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false

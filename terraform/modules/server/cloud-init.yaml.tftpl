#cloud-config
# First boot of a learnplat VM: Docker, tools, /data volume, the pull-based deploy watcher and
# the nightly backup timer. Secrets are NOT here: the operator adds them per the runbook
# (docs/deployment/pipeline-secrets.md): app.env, the APP_DOMAIN line, backup keys, GHCR login.
package_update: true
package_upgrade: true
packages:
  - docker.io
  - docker-compose-v2
  - age
  - rclone
  - certbot
  - cryptsetup
  - curl
  - unattended-upgrades

write_files:
  - path: /etc/docker/daemon.json
    permissions: "0644"
    content: |
      {"log-driver": "json-file", "log-opts": {"max-size": "10m", "max-file": "5"}}
  - path: /etc/learnplat/deploy.env
    permissions: "0644"
    content: |
      LEARNPLAT_ENV=${environment}
      IMAGE_REPO=${image_repository}
      # APP_DOMAIN=<set by the operator; see docs/deployment/pipeline-secrets.md>
  - path: /etc/learnplat/backup.env
    permissions: "0600"
    content: |
      BACKUP_BUCKET=${backup_bucket_name}
      RCLONE_CONFIG_HETZNER_TYPE=s3
      RCLONE_CONFIG_HETZNER_PROVIDER=Other
      RCLONE_CONFIG_HETZNER_ENDPOINT=${object_storage_endpoint}
      # RCLONE_CONFIG_HETZNER_ACCESS_KEY_ID / _SECRET_ACCESS_KEY and HEARTBEAT_URL: operator adds.
  - path: /usr/local/bin/learnplat-watch
    permissions: "0755"
    content: |
      ${indent(6, watch_script)}
  - path: /usr/local/sbin/learnplat-data-volume
    permissions: "0755"
    content: |
      ${indent(6, data_volume_script)}
  - path: /etc/logrotate.d/learnplat
    permissions: "0644"
    content: |
      ${indent(6, logrotate_conf)}
  - path: /etc/cron.d/learnplat-healthcheck
    permissions: "0644"
    content: |
      # Every 5 minutes: /healthz through the app container; restart after 3 failures in a row.
      */5 * * * * root sh -c 'r=$(cat /var/lib/learnplat/current-release 2>/dev/null) && [ -n "$r" ] && "$r/healthcheck.sh"'

  - path: /etc/systemd/system/learnplat-watch.service
    permissions: "0644"
    content: |
      ${indent(6, watch_service)}
  - path: /etc/systemd/system/learnplat-watch.timer
    permissions: "0644"
    content: |
      ${indent(6, watch_timer)}
  - path: /etc/systemd/system/learnplat-backup.service
    permissions: "0644"
    content: |
      ${indent(6, backup_service)}
  - path: /etc/systemd/system/learnplat-backup.timer
    permissions: "0644"
    content: |
      ${indent(6, backup_timer)}

runcmd:
  - mkdir -p /var/lib/learnplat/releases /var/www/certbot /var/log/learnplat
  # LUKS2-encrypt (first boot only), open and mount the data volume at /data; idempotent.
  - /usr/local/sbin/learnplat-data-volume ${volume_device}
  - systemctl restart docker
  - systemctl daemon-reload
  - systemctl enable --now learnplat-watch.timer learnplat-backup.timer
